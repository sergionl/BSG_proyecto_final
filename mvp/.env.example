# Copia este archivo a .env y completa los valores reales.
# Nunca comitees el .env con la clave real.

# Proveedor de modelo: OpenAI directo (misma decision que el PoC).
OPENAI_API_KEY=sk-...
MODEL_ID=gpt-5.6-luna

# URL del servidor de tools FastMCP (api/mcp.py). En local, puerto 8001.
MCP_URL=http://127.0.0.1:8001/

# Umbral de confianza bajo el cual una foto se marca para revision humana.
CONFIDENCE_REVIEW_THRESHOLD=0.80

# Trazabilidad opcional con LangSmith. Dejar vacio para no activarla.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
